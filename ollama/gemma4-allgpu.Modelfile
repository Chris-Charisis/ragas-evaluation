# gemma4:12b-it-q8_0 with all 49 layers on the GPU (the Q-A generator, llm.qa_generator).
# Same weights, template, renderer/parser and sampling defaults as the official tag; only num_gpu
# is added. Without it, Ollama 0.40.6's memory fit keeps one layer on the CPU: the full model
# would leave 1,104 MiB of VRAM free, 102 MiB under its 1,206 MiB margin (2026-10-19). All on GPU
# it still leaves ~1.2 GB free and decodes 16% faster (55 vs 47 tokens/s).
# Build once (after `ollama pull gemma4:12b-it-q8_0`):
#   ollama create gemma4-allgpu:12b-it-q8_0 -f ollama/gemma4-allgpu.Modelfile
FROM gemma4:12b-it-q8_0
PARAMETER num_gpu 49
