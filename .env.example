# Copy to .env and fill in. Load with python-dotenv (see src/chunkeval/core/config.py).
# The keys hard-coded in ragas_evaluation.py were exposed — create NEW ones.

OPENAI_API_KEY=
HF_TOKEN=
WEAVIATE_API_KEY=

# Ollama's OpenAI-compatible endpoint (no key needed; the native API is the same URL without /v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Only for the optional Ollama container (docker compose --profile ollama): host port to publish.
# Leave unset (= 11434). Use 11435 for a side-by-side test next to the system service.
# OLLAMA_HOST_PORT=11435
